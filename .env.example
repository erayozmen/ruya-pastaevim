# Copy to .env.local and fill in real values there. Never commit real secrets.

# Supabase (public — safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase service role key — bypasses RLS. Server-only, never NEXT_PUBLIC_,
# never committed. Used exclusively by src/lib/supabase/service.ts to read
# and write the instagram_oauth_tokens table (which has no anon/authenticated
# RLS policies at all — this key is the only way to access it).
SUPABASE_SERVICE_ROLE_KEY=

# Production origin, no trailing slash. Used to build canonical URLs,
# robots.txt/sitemap.xml, Open Graph URLs, and the Instagram OAuth
# redirect_uri. Falls back to http://localhost:3000 if unset.
NEXT_PUBLIC_SITE_URL=

# Instagram — manual token fallback (see src/lib/instagram.ts).
# A long-lived Instagram User Access Token (60 days), generated via the
# Meta App Dashboard or via the OAuth connect flow below. Server-only,
# never NEXT_PUBLIC_.
INSTAGRAM_ACCESS_TOKEN=

# Instagram Business Login OAuth (see src/app/api/instagram/authorize
# and src/app/api/instagram/callback). From the Meta App Dashboard,
# App Settings → Basic. INSTAGRAM_APP_SECRET is server-only, never
# NEXT_PUBLIC_, and must never be committed.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
